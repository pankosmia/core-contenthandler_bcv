{
  "id": "core-contenthandler_bcv",
  "exclude_from_menu": true,
  "minServerVersion": "0.16.1",
  "exclude_from_dashboard": true,
  "require": {
    "net": false,
    "debug": false
  },
  "endpoints": {
    "x-bcvnotes": {
      "create_document": [
        {
          "doc": "Create document translationNotes for bcv",
          "label": "pages:core-contenthandler_bcv:create_content_tn",
          "url": "/createDocument/bookChapterVerse?resourceType=tn"
        }
      ],
      "new_book": [
        {
          "doc": "Add a book to a translationNotes document",
          "label": "pages:content:new_book",
          "url": "/newBook?repoPath=%%REPO_PATH%%"
        }
      ],
      "export": [
        {
          "subMenu": [
            {
              "tsv": [
                {
                  "doc": "Export to tsv a textTranslation document",
                  "placeHolders": {
                    "REPO_PATH": {
                      "doc": "The path to the repo in <X>/<Y>/<Z> format"
                    }
                  },
                  "label": "pages:core-contenthandler_bcv:export_as_tsv",
                  "url": "/export/tsv?repoPath=%%REPO_PATH%%"
                }
              ]
            }
          ]
        }
      ]
    },
    "x-bcvquestions": {
      "create_document": [
        {
          "label": "pages:core-contenthandler_bcv:create_content_tq",
          "url": "/createDocument/bookChapterVerse?resourceType=tq"
        },
        {
          "label": "pages:core-contenthandler_bcv:create_content_sq",
          "url": "/createDocument/bookChapterVerse?resourceType=sq"
        }
      ],
      "new_book": [
        {
          "label": "pages:content:new_book",
          "url": "/newBook?repoPath=%%REPO_PATH%%"
        }
      ],
      "export": [
        {
          "subMenu": [
            {
              "tsv": [
                {
                  "doc": "Export to tsv a textTranslation document",
                  "placeHolders": {
                    "REPO_PATH": {
                      "doc": "The path to the repo in <X>/<Y>/<Z> format"
                    }
                  },
                  "label": "pages:core-contenthandler_bcv:export_as_tsv",
                  "url": "/export/tsv?repoPath=%%REPO_PATH%%"
                }
              ]
            }
          ]
        }
      ]
    }
  },
